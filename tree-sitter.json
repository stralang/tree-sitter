{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "stra",
      "camelcase": "Stra",
      "title": "Stra",
      "scope": "source.stra",
      "file-types": [
        "stra"
      ],
      "injection-regex": "^stra$",
      "class-name": "TreeSitterStra"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "zlib",
    "description": "grammer for the stra programming language",
    "authors": [
      {
        "name": "PixelDoted"
      }
    ],
    "links": {
      "repository": "https://github.com/stralang/tree-sitter"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}